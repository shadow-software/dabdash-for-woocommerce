<?xml version="1.0"?>
<ruleset name="DabDash Sync for WooCommerce">
	<description>WordPress-Extra + Docs, PHP 8.1+.</description>
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<config name="text_domain" value="dabdash-for-woocommerce"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="dabdash-for-woocommerce"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="DabDashSync"/>
				<element value="DABDASH_WOO"/>
				<element value="dabdash_woo"/>
				<element value="dabdash_woo_"/>
			</property>
		</properties>
	</rule>
	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.2-"/>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
		<exclude-pattern>*/includes/*</exclude-pattern>
	</rule>

	<!--
		Sync\FieldMap and Sync\Resolver are pure domain objects with camelCase
		method names (resolveCanonical, mergeConsent, …) pinned by unit tests.
		Renaming them to snake_case would churn the public sync API for no gain.
	-->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>*/includes/Sync/*</exclude-pattern>
	</rule>
</ruleset>
